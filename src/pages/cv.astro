---
import cvData from "../data/cv.json";
import CvLogo from "../components/CvLogo.astro";
import "../styles/global.css";

if (!import.meta.env.DEV) {
    return new Response(null, { status: 404, statusText: "Not found" });
}

// Break into pages for A4 printing
const escapeHtml = (value: string) =>
    value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");

const externalLinkHtml = (href: string, label: string) =>
    `<a href="${escapeHtml(href)}" class="text-brand no-underline">${escapeHtml(
        label,
    )}</a>`;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>CV - {cvData.header.name} {cvData.header.surname}</title>
        <style>
            @page {
                size: A4;
                margin: 0;
            }
            body {
                margin: 0;
                background: white;
                color: var(--color-brand-text);
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                font-family: var(--font-sans);
            }
            .page {
                width: 210mm;
                min-height: 297mm;
                padding: 15mm 20mm;
                box-sizing: border-box;
                page-break-after: always;
                position: relative;
                background: white;
                overflow: hidden;
            }

            h1,
            h2,
            h3,
            h4,
            .font-display {
                font-family: var(--font-display);
            }

            .text-brand {
                color: var(--color-brand-blue);
            }
            .personal-data :global(a.text-brand.no-underline) {
                color: var(--color-brand-blue);
                text-decoration: none;
            }

            /* Header */
            .cv-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
            }
            .cv-header-logo {
                font-size: 24px;
                font-weight: 300;
                letter-spacing: 1px;
                margin-left: -10px;
            }
            .cv-header-logo span {
                font-weight: 600;
            }
            .cv-header-title {
                font-size: 20px;
                font-weight: 300;
                color: var(--color-brand-blue);
            }

            /* Positioning Section */
            .positioning-block {
                margin-bottom: 25px;
                font-size: 13px;
                line-height: 1.5;
            }
            .positioning-summary {
                margin-bottom: 12px;
                text-align: justify;
            }
            .positioning-strengths {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                margin-bottom: 15px;
            }
            .strength-badge {
                background-color: var(--color-brand-bg);
                color: var(--color-brand-blue);
                padding: 4px 10px;
                border-radius: 4px;
                font-size: 11px;
                font-weight: 600;
            }
            .recognition-badge {
                background-color: transparent;
                color: var(--color-brand-blue);
                padding: 3px 9px;
                border-radius: 4px;
                font-size: 11px;
                font-weight: 600;
                border: 1px solid var(--color-brand-blue);
                display: flex;
                align-items: center;
                gap: 5px;
            }

            /* Section Titles */
            .section-title {
                font-size: 15px;
                font-weight: 400;
                text-transform: uppercase;
                letter-spacing: 2px;
                margin-bottom: 18px;
                color: #3e3e3f;
                padding-bottom: 5px;
                margin-top: 36px;
            }
            .section-title span {
                font-weight: 700;
                color: var(--color-brand-blue);
            }

            /* Selected Impact */
            .impact-list {
                margin: 0 0 25px 0;
                font-size: 12.5px;
                line-height: 1.5;
            }
            .impact-list li {
                margin-bottom: 18px;
                padding-left: 18px;
                border-left: 1px solid var(--color-brand-blue);
                font-style: italic;
            }

            /* Personal Data Grid */
            .personal-data-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 10px;
                font-size: 11px;
                margin-bottom: 30px;
                background: #f9f9f9;
                padding: 12px;
                border-radius: 6px;
            }
            .data-item {
                display: flex;
                flex-direction: column;
            }
            .data-label {
                font-weight: 700;
                color: #3e3e3f;
                font-size: 9px;
                text-transform: uppercase;
                margin-bottom: 2px;
            }
            .data-value {
                font-weight: 500;
            }

            /* Timeline */
            .timeline {
                position: relative;
                margin-left: 140px;
                padding-bottom: 10px;
            }
            .timeline-item {
                position: relative;
                margin-bottom: 20px;
                min-height: 24px;
            }
            .timeline-item:not(:last-child)::before,
            .timeline-continued .timeline-item:last-child::before {
                content: "";
                position: absolute;
                top: 0;
                bottom: -20px;
                left: 20px;
                width: 1px;
                background-color: #93d9fe;
                z-index: 1;
            }
            .timeline-continued .timeline-item:last-child::before {
                bottom: -1500px;
            }
            .timeline-date {
                position: absolute;
                left: -140px;
                top: -8px;
                width: 115px;
                white-space: nowrap;
                background-color: var(--color-brand-blue);
                color: white;
                font-size: 10px;
                padding: 6px 10px;
                text-align: right;
                border-radius: 12px;
                border-bottom-right-radius: 2px;
            }
            .timeline-icon {
                position: absolute;
                left: 7px;
                top: -6px;
                width: 28px;
                height: 28px;
                background-color: var(--color-brand-blue);
                border-radius: 50%;
                border: 4px solid white;
                z-index: 2;
                display: flex;
                align-items: center;
                justify-content: center;
            }
            .timeline-content {
                margin-left: 40px;
                font-size: 13px;
                position: relative;
                top: -1px;
            }
            .timeline-title {
                font-weight: 600;
                margin-bottom: 2px;
            }
            .timeline-company {
                color: var(--color-brand-blue);
                font-weight: 700;
                font-size: 12px;
            }
            .timeline-bullets {
                margin-top: 8px;
                font-size: 11px;
                line-height: 1.45;
                color: #888;
                margin-bottom: 0;
            }
            .timeline-bullets li {
                margin-bottom: 4px;
            }
            .timeline-bullets li::marker {
                color: var(--color-brand-blue);
            }

            /* Compact Skills */
            .compact-skills {
                margin-top: 20px;
                font-size: 12px;
            }
            .compact-skills-group {
                margin-bottom: 12px;
            }
            .compact-skills-label {
                font-weight: 700;
                color: var(--color-brand-blue);
                margin-bottom: 2px;
                display: block;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }
            .compact-skills-items {
                color: #555;
            }

            /* Utilities */
            .font-bold {
                font-weight: 700;
            }
        </style>
    </head>
    <body>
        <!-- PAGE 1: Intro, Positioning, Impact & Recent Experience -->
        <div class="page">
            <div class="cv-header font-display">
                <div class="cv-header-logo">
                    <CvLogo />
                </div>
                <div class="cv-header-title">/ CV</div>
            </div>

            <!-- Positioning -->
            <div class="positioning-block">
                <div class="positioning-summary">
                    {cvData.positioning.summary}
                </div>
                <div class="positioning-strengths">
                    {
                        cvData.positioning.strengths.map((str) => (
                            <span class="strength-badge">{str}</span>
                        ))
                    }
                    {
                        cvData.positioning.recognition?.map((item) => (
                            <span class="recognition-badge">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="10"
                                    height="10"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                </svg>
                                {item}
                            </span>
                        ))
                    }
                </div>
            </div>

            <div class="section-title">SELECTED <span>IMPACT</span></div>
            <ul class="impact-list">
                {
                    cvData.positioning.selectedImpact.map((impact) => (
                        <li>{impact}</li>
                    ))
                }
            </ul>

            <div class="section-title">
                WORK <span>EXPERIENCE</span>
            </div>
            <div class="timeline timeline-continued">
                {
                    cvData.workExperience.slice(0, 1).map((item) => (
                        <div class="timeline-item">
                            <div class="timeline-date">
                                {item.start} - {item.end}
                            </div>
                            <div class="timeline-icon">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="10"
                                    height="10"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="white"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        x="3"
                                        y="4"
                                        width="18"
                                        height="18"
                                        rx="2"
                                        ry="2"
                                    />
                                    <line x1="16" y1="2" x2="16" y2="6" />
                                    <line x1="8" y1="2" x2="8" y2="6" />
                                    <line x1="3" y1="10" x2="21" y2="10" />
                                </svg>
                            </div>
                            <div class="timeline-content">
                                <div class="timeline-title">{item.title}</div>
                                <div class="timeline-company">
                                    {item.company}
                                </div>
                                {item.bullets && item.bullets.length > 0 && (
                                    <ul class="timeline-bullets">
                                        {item.bullets.map((b) => (
                                            <li>{b}</li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- PAGE 2: Continued Experience -->
        <div class="page">
            <div class="timeline timeline-continued" style="margin-top: 10px;">
                {
                    cvData.workExperience.slice(1, 6).map((item) => (
                        <div class="timeline-item">
                            <div class="timeline-date">
                                {item.start} - {item.end}
                            </div>
                            <div class="timeline-icon">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="10"
                                    height="10"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="white"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        x="3"
                                        y="4"
                                        width="18"
                                        height="18"
                                        rx="2"
                                        ry="2"
                                    />
                                    <line x1="16" y1="2" x2="16" y2="6" />
                                    <line x1="8" y1="2" x2="8" y2="6" />
                                    <line x1="3" y1="10" x2="21" y2="10" />
                                </svg>
                            </div>
                            <div class="timeline-content">
                                <div class="timeline-title">{item.title}</div>
                                <div class="timeline-company">
                                    {item.company}
                                </div>
                                {item.bullets && item.bullets.length > 0 && (
                                    <ul class="timeline-bullets">
                                        {item.bullets.map((b) => (
                                            <li>{b}</li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- PAGE 3: Older Experience, Education, Skills & Contact -->
        <div class="page">
            <div class="timeline" style="margin-top: 10px;">
                {
                    cvData.workExperience.slice(6).map((item) => (
                        <div class="timeline-item">
                            <div class="timeline-date">
                                {item.start} - {item.end}
                            </div>
                            <div class="timeline-icon">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="10"
                                    height="10"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="white"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        x="3"
                                        y="4"
                                        width="18"
                                        height="18"
                                        rx="2"
                                        ry="2"
                                    />
                                    <line x1="16" y1="2" x2="16" y2="6" />
                                    <line x1="8" y1="2" x2="8" y2="6" />
                                    <line x1="3" y1="10" x2="21" y2="10" />
                                </svg>
                            </div>
                            <div class="timeline-content">
                                <div class="timeline-title">{item.title}</div>
                                <div class="timeline-company">
                                    {item.company}
                                </div>
                                {item.bullets && item.bullets.length > 0 && (
                                    <ul class="timeline-bullets">
                                        {item.bullets.map((b) => (
                                            <li>{b}</li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="section-title" style="margin-top: 30px;">
                EXAMS AND <span>EDUCATION</span>
            </div>
            <div class="timeline">
                {
                    cvData.examsAndEducation.map((item) => (
                        <div class="timeline-item">
                            <div class="timeline-date">
                                {item.start}
                                {item.end ? ` - ${item.end}` : ""}
                            </div>
                            <div class="timeline-icon">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="10"
                                    height="10"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="white"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        x="3"
                                        y="4"
                                        width="18"
                                        height="18"
                                        rx="2"
                                        ry="2"
                                    />
                                    <line x1="16" y1="2" x2="16" y2="6" />
                                    <line x1="8" y1="2" x2="8" y2="6" />
                                    <line x1="3" y1="10" x2="21" y2="10" />
                                </svg>
                            </div>
                            <div class="timeline-content">
                                <div class="timeline-title">{item.title}</div>
                                {item.institution && (
                                    <div class="timeline-company">
                                        {item.institution}
                                    </div>
                                )}
                                {item.bullets && item.bullets.length > 0 && (
                                    <ul class="timeline-bullets">
                                        {item.bullets.map((b) => (
                                            <li>
                                                <span class="font-bold">
                                                    {b}
                                                </span>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- PAGE 4: Skills & Contact -->
        <div class="page">
            <div class="section-title">
                TECHNICAL CAPABILITIES & <span>LANGUAGES</span>
            </div>
            <div class="compact-skills">
                <div class="compact-skills-group">
                    <span class="compact-skills-label">Languages</span>
                    <span class="compact-skills-items"
                        >{cvData.compactSkills.languages}</span
                    >
                </div>
                {
                    cvData.compactSkills.technical.map((tech) => (
                        <div class="compact-skills-group">
                            <span class="compact-skills-label">
                                {tech.category}
                            </span>
                            <span class="compact-skills-items">
                                {tech.items}
                            </span>
                        </div>
                    ))
                }
            </div>

            <div class="section-title" style="margin-top: 40px;">
                PERSONAL <span>DATA</span>
            </div>
            <div class="personal-data-grid">
                <div class="data-item">
                    <span class="data-label">Email</span>
                    <span
                        class="data-value"
                        set:html={externalLinkHtml(
                            `mailto:${cvData.personalData.EMAIL.replace("mailto:", "")}`,
                            cvData.personalData.EMAIL.replace("mailto:", ""),
                        )}
                    />
                </div>
                <div class="data-item">
                    <span class="data-label">Website</span>
                    <span
                        class="data-value"
                        set:html={externalLinkHtml(
                            cvData.personalData.WEBSITE,
                            cvData.personalData.WEBSITE,
                        )}
                    />
                </div>
                <div class="data-item">
                    <span class="data-label">LinkedIn</span>
                    <span
                        class="data-value"
                        set:html={externalLinkHtml(
                            cvData.personalData.LINKEDIN,
                            cvData.personalData.LINKEDIN,
                        )}
                    />
                </div>
                <div class="data-item">
                    <span class="data-label">Phone</span>
                    <span class="data-value"
                        >{cvData.personalData["PHONE NUMBER"]}</span
                    >
                </div>
                <div class="data-item">
                    <span class="data-label">Residence</span>
                    <span class="data-value"
                        >{cvData.personalData.RESIDENCE}</span
                    >
                </div>
                <div class="data-item">
                    <span class="data-label">Nationality</span>
                    <span class="data-value"
                        >{cvData.personalData.NATIONALITY}</span
                    >
                </div>
            </div>
        </div>
    </body>
</html>
